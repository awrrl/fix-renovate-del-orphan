{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": ["400XXXX/develop"],
  "branchPrefix": "",
  "additionalBranchPrefix": "{{lookup (split baseBranch '/') 0 }}/quality/renovate-{{{branchTopic}}}",
  "useBaseBranchConfig": "merge",
  "packageRules": [
    {
      "matchDatasources": [ "maven" ],
      "allowedVersions": "<3.20.0"      
    }
  ]
}
